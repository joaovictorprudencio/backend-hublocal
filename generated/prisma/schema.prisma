generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String
  companies Company[]
}

model Company {
  id        Int        @id @default(autoincrement())
  name      String
  website   String
  cnpj      String     @unique
  user      User       @relation(fields: [userId], references: [id])
  userId    Int
  locations Location[]
}

model Location {
  id        Int     @id @default(autoincrement())
  name      String
  zipCode   String
  street    String
  number    String
  district  String
  city      String
  state     String
  company   Company @relation(fields: [companyId], references: [id])
  companyId Int
}
